{
  "name": "avalon-roundtable",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx --env-file-if-exists=.env.local server/local.ts",
    "dev:web": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && npm run build:cloud",
    "build:cloud": "node scripts/build-cloud.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke:cloud": "tsx scripts/smoke-cloud.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^3.16.0",
    "lodash.set": "file:vendor/avalon-safe-lodash-set-1.0.0.tgz",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "axios": "^0.33.0",
    "lodash.set": "$lodash.set",
    "lodash.unset": "^4.18.0"
  }
}
