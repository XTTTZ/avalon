{
  "name": "avalon-roundtable",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx --env-file-if-exists=.env.local server/local.ts",
    "dev:web": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "build": "npm run typecheck && vite build",
    "worker:types": "wrangler types --include-runtime false",
    "worker:types:check": "wrangler types --include-runtime false --check",
    "worker:dev": "npm run build && wrangler dev",
    "worker:dry-run": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "worker:deploy": "npm run build && wrangler deploy",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "esbuild": "0.28.2",
    "jsdom": "^29.1.1",
    "miniflare": "5.20261006.2-beta",
    "prettier": "^3.9.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.150.0"
  }
}
