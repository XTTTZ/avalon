# Local: copy to .env.local. No CloudBase / WeChat account is needed.
VITE_AUTH_MODE=guest
VITE_API_URL=/api
ALLOW_GUEST=true

# Production browser build (put in .env.production.local):
# VITE_AUTH_MODE=wechat
# VITE_API_URL=https://api.example.com/api/avalon

# The following belong ONLY in cloud function environment variables; NEVER VITE_*.
# SESSION_SECRET=<at least 32 random characters>
# IDENTITY_SECRET=<stable random secret; retain when rotating SESSION_SECRET>
# CLOUDBASE_ENV_ID=<env-id>
# ALLOW_GUEST=false
# WECHAT_APP_ID=<official account appid>
# WECHAT_APP_SECRET=<official account secret>
# WECHAT_REDIRECT_URIS=https://avalon.example.com/
# ALLOWED_ORIGINS=https://avalon.example.com
