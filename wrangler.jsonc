{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "avalon",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "www.avalonxty.site",
      "custom_domain": true,
    },
  ],
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/ws"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM_HUB", "class_name": "RoomHub" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomHub"] }],
  "triggers": { "crons": ["7 18 * * *"] },
  "vars": {
    "ALLOW_GUEST": "true",
    "ALLOWED_ORIGINS": "https://www.avalonxty.site",
    "WECHAT_REDIRECT_URIS": "https://www.avalonxty.site/",
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
}
